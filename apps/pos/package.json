{
  "name": "@gestglobale/pos",
  "version": "0.1.0",
  "private": true,
  "description": "Caisse GestGlobale — vend sur sa base locale, meme sans reseau",
  "main": "dist/principal/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "build:principal": "tsc -p tsconfig.json",
    "dev": "concurrently \"tsc -p tsconfig.json --watch\" \"vite\"",
    "demarrer": "electron dist/principal/index.js",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gestglobale/shared": "workspace:*",
    "better-sqlite3": "11.5.0",
    "argon2": "0.41.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "concurrently": "9.0.1",
    "electron": "33.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.3"
  }
}