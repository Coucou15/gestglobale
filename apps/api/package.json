    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.4.6",
    "@nestjs/schedule": "4.1.1",
    "@nestjs/swagger": "8.0.1",
    "@prisma/client": "5.22.0",
    "argon2": "0.41.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "exceljs": "4.4.0",
